TZ=UTC
PORT=3333
HOST=localhost
APP_URL=http://${HOST}:${PORT}
LOG_LEVEL=info
APP_KEY=
NODE_ENV=development
SESSION_DRIVER=cookie

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=emerald

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Comma-separated proxy URLs for scraper pool rotation
# SCRAPER_PROXY_URLS=http://user:pass@proxy1:8080,http://user:pass@proxy2:8080
# Comma-separated geo codes matching proxy URLs positions (* = any geo)
# SCRAPER_PROXY_GEOS=US,DE,*

# 2Captcha API key for CAPTCHA solving (optional)
# CAPTCHA_2CAPTCHA_API_KEY=

# Playwright browser pool (optional)
# PLAYWRIGHT_ENABLED=true
# PLAYWRIGHT_MAX_CONTEXTS=5

# Google OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3333/auth/google/callback

# Stripe billing (optional)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_STARTER_PRICE_ID=price_...
# STRIPE_GROWTH_PRICE_ID=price_...
# STRIPE_PRO_PRICE_ID=price_...